# MongoDB Atlas Connection (Required for persistent database)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=HerShield
MONGODB_DB=hershield

# Authentication Secret (Generate a strong random 32+ char string for production)
AUTH_SECRET=replace-with-a-strong-random-32-char-secret
# Set to "true" to bypass login screens for local testing
DISABLE_LOGIN=false

# Local AI Service Connection (On Vercel, set to your secure tunnel URL e.g. https://xxxx.trycloudflare.com)
AI_SERVICE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_AI_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_SECRET=replace-with-shared-ai-service-secret

# Telegram Bot API (Server-side only — never prefix with NEXT_PUBLIC_)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Public App URL (Used in Telegram alert deep links)
NEXT_PUBLIC_APP_URL=http://localhost:3000
