# Local Python FastAPI AI Service Configuration (Runs on Laptop)
AI_SERVICE_SECRET=replace-with-shared-ai-service-secret
APP_BACKEND_URL=http://127.0.0.1:3000

# Compute & Model Configuration
# Options: auto, cuda, cpu
MODEL_DEVICE=auto
MODEL_CONFIDENCE_THRESHOLD=0.40
CAMERA_SOURCE=0
INFERENCE_SIZE=640
INFERENCE_FPS_TARGET=15

# PrivacyShield Buffer Settings (seconds)
PRIVACY_BUFFER_PRE_SECONDS=4
PRIVACY_BUFFER_POST_SECONDS=3

# Collapse & Aggression Thresholds
COLLAPSE_CONFIRM_SECONDS=5.0
AGGRESSION_CONFIDENCE_THRESHOLD=0.58

# Server Binding
AI_HOST=127.0.0.1
AI_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
